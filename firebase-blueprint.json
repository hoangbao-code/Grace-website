{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Persistent study profile for Google-authenticated members of 100-Day Mastery Club.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "avatarEmoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "studyGoal": {
          "type": "string",
          "maxLength": 120
        },
        "streak": {
          "type": "number"
        },
        "level": {
          "type": "number"
        },
        "xp": {
          "type": "number"
        },
        "isPro": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "avatarEmoji",
        "studyGoal",
        "streak",
        "level",
        "xp",
        "isPro",
        "createdAt",
        "updatedAt"
      ]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Personal 100-day reflection journal note owned by an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "day": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "day",
        "note",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-isolated study profile document."
    },
    "/users/{userId}/journals/{dayId}": {
      "schema": {
        "$ref": "#/entities/JournalEntry"
      },
      "description": "Owner-isolated daily reflection journal notes."
    }
  }
}
