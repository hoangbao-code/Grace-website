rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'avatarEmoji', 'studyGoal',
          'streak', 'level', 'xp', 'isPro', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'avatarEmoji', 'photoUrl', 'studyGoal',
          'streak', 'level', 'xp', 'isPro', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.avatarEmoji is string && data.avatarEmoji.size() >= 1 && data.avatarEmoji.size() <= 16
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.studyGoal is string && data.studyGoal.size() <= 120
        && data.streak is number && data.streak >= 0 && data.streak <= 1000
        && data.level is number && data.level >= 1 && data.level <= 500
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.isPro is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data, userId) {
      return data.keys().hasAll(['userId', 'day', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'day', 'note', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.day is number && data.day >= 1 && data.day <= 100
        && data.note is string && data.note.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarEmoji', 'photoUrl', 'studyGoal',
          'streak', 'level', 'xp', 'isPro', 'updatedAt'
        ]);

      allow delete: if false;

      // Subcollection: /users/{userId}/journals/{dayId}
      match /journals/{dayId} {
        allow get: if isValidId(userId) && isValidId(dayId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(dayId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidJournalEntry(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(dayId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidJournalEntry(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().day == existing().day
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(dayId) && isOwner(userId);
      }
    }
  }
}
